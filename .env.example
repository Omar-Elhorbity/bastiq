# ---------------------------------------------------------------------------
# Bastiq configuration. Copy to `.env` and fill in. NEVER commit a real .env.
# In docker-compose, `web` and `worker` read this file via `env_file`.
# ---------------------------------------------------------------------------

# --- Core ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=true                      # MUST be false in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=           # e.g. https://bastiq.onrender.com (prod)
FRONTEND_URL=http://localhost:8000     # base for verify/reset/checkout links

# --- Database (inside docker-compose the host is `db`) ---
DATABASE_URL=postgres://postgres:postgres@db:5432/bastiq

# --- Redis / Celery (inside docker-compose the host is `redis`) ---
REDIS_URL=redis://redis:6379/0

# --- Email ---
# console (dev, logs to stdout) | locmem (tests) | smtp | sendgrid
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=no-reply@bastiq.local
SENDGRID_API_KEY=                      # required only when EMAIL_BACKEND=sendgrid

# --- API docs ---
# Swagger UI (/api/docs) and schema (/api/schema) are public by default (the
# demo needs a reachable Swagger). Set true to require auth for both.
DOCS_REQUIRE_AUTH=false

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=                     # sk_test_...
STRIPE_WEBHOOK_SECRET=                 # whsec_...
# Plan price ids are seeded (see seed command) or set per-plan in admin.

# --- Throttling (optional overrides) ---
# THROTTLE_ANON=120/min
# THROTTLE_LOGIN=10/min
